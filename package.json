{
  "name": "xyz-classroom-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "smoke": "node scripts/smoke.mjs",
    "visual": "node scripts/visual-check.mjs",
    "formula:check": "node scripts/formula-check.mjs",
    "practice:check": "node scripts/practice-check.mjs",
    "server": "go run ./server",
    "server:test": "go test ./server/...",
    "auth:check": "node scripts/auth-check.mjs",
    "server:build": "node scripts/build-server.mjs",
    "server:sync": "node scripts/server-sync-check.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
